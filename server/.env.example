# SmartNest AI Payment & Subscription Backend Environment Configuration
PORT=5000
NODE_ENV=development

# Razorpay Credentials (Never commit actual secrets to source control)
# Public Key ID is shared with frontend; Key Secret & Webhook Secret MUST remain on server only.
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpayKeySecretHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
